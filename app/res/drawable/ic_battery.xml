<?xml version="1.0" encoding="utf-8"?>
<!-- 电池图标：浅绿底 + 深灰电池壳 + 绿色电量条（约 60%）。
     用 VectorDrawable 而不是 png：一个文件适配所有密度，改色也方便。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底色 -->
    <path
        android:fillColor="#E1F5EE"
        android:pathData="M0,0h108v108h-108z" />

    <!-- 电池外壳（描边，不填充） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2C2C2A"
        android:strokeWidth="4"
        android:pathData="M30,36h40a8,8 0 0 1 8,8v20a8,8 0 0 1 -8,8h-40a8,8 0 0 1 -8,-8v-20a8,8 0 0 1 8,-8z" />

    <!-- 正极凸起 -->
    <path
        android:fillColor="#2C2C2A"
        android:pathData="M78,48h5a3,3 0 0 1 3,3v6a3,3 0 0 1 -3,3h-5z" />

    <!-- 电量条：约 60% -->
    <path
        android:fillColor="#1D9E75"
        android:pathData="M32,42h22a4,4 0 0 1 4,4v16a4,4 0 0 1 -4,4h-22a4,4 0 0 1 -4,-4v-16a4,4 0 0 1 4,-4z" />

</vector>
