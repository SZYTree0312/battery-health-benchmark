<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tree0312.bhbench">

    <!-- 前台服务：放电测试要跑几小时，必须避免被系统或 ROM 回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 结果页的「去放行」入口：只用来跳系统设置，不申请常驻忽略 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_battery"
        android:allowBackup="true"
        android:theme="@style/AppTheme">

        <!-- LAUNCHER 交给唤醒动画。独立成 Activity 而不是 MainActivity 里盖一层，
             这样只有冷启动会播，从结果页返回或在后台切回前台都不会重播。 -->
        <activity
            android:name=".WakeActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="false" />

        <activity
            android:name=".ResultActivity"
            android:label="测量结果"
            android:exported="false" />

        <activity
            android:name=".HistoryActivity"
            android:label="历史记录"
            android:exported="false" />

        <activity
            android:name=".AccuracyActivity"
            android:label="积分精度验证"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:label="设置"
            android:exported="false" />

        <service
            android:name=".SamplerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
